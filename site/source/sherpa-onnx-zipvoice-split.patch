diff --git a/sherpa-onnx/csrc/offline-tts-zipvoice-impl.h b/sherpa-onnx/csrc/offline-tts-zipvoice-impl.h
index 499f9eb..fc1ddbc 100644
--- a/sherpa-onnx/csrc/offline-tts-zipvoice-impl.h
+++ b/sherpa-onnx/csrc/offline-tts-zipvoice-impl.h
@@ -253,6 +253,131 @@ class OfflineTtsZipvoiceImpl : public OfflineTtsImpl {
     return Generate(text, config, std::move(callback));
   }
 
+  // [on-device-web-tts] Split pipeline: everything Generate() does for one
+  // text chunk up to (and including) drawing the initial noise. The caller
+  // runs the Euler loop over the decoder and then calls ZipvoiceVocode().
+  bool ZipvoicePrepare(const std::string &text, const GenerationConfig &config,
+                       int32_t chunk_index,
+                       ZipvoicePrepared *out) const override {
+    float feat_scale =
+        config.GetExtraFloat("feat_scale", config_.model.zipvoice.feat_scale);
+    float t_shift =
+        config.GetExtraFloat("t_shift", config_.model.zipvoice.t_shift);
+    float target_rms =
+        config.GetExtraFloat("target_rms", config_.model.zipvoice.target_rms);
+    float guidance_scale = config.GetExtraFloat(
+        "guidance_scale", config_.model.zipvoice.guidance_scale);
+
+    std::vector<int64_t> prompt_tokens;
+    for (const auto &t : frontend_->ConvertTextToTokenIds(config.reference_text)) {
+      prompt_tokens.insert(prompt_tokens.end(), t.tokens.begin(), t.tokens.end());
+    }
+    if (prompt_tokens.empty()) {
+      SHERPA_ONNX_LOGE("Failed to convert prompt text to token IDs");
+      return false;
+    }
+
+    std::vector<float> prompt_features = ComputePromptFeatures(
+        config.reference_audio, config.reference_sample_rate, feat_scale,
+        target_rms);
+    if (prompt_features.empty()) {
+      SHERPA_ONNX_LOGE("No frames extracted from the prompt audio");
+      return false;
+    }
+
+    auto sentences = SplitByPunctuation(text);
+    sentences = MergeShortSentences(
+        sentences, config.GetExtraInt("min_char_in_sentence", 30));
+    std::vector<std::string> chunks;
+    for (const auto &s : sentences) {
+      auto pieces =
+          SplitLongSentence(s, config.GetExtraInt("max_char_in_sentence", 200));
+      chunks.insert(chunks.end(), pieces.begin(), pieces.end());
+    }
+
+    *out = ZipvoicePrepared{};
+    out->num_chunks = static_cast<int32_t>(chunks.size());
+    out->t_shift = t_shift;
+    out->guidance_scale = guidance_scale;
+    if (chunk_index < 0 || chunk_index >= out->num_chunks) {
+      SHERPA_ONNX_LOGE("chunk_index %d out of range [0, %d)", chunk_index,
+                       out->num_chunks);
+      return false;
+    }
+
+    std::vector<int64_t> tokens;
+    for (const auto &t : frontend_->ConvertTextToTokenIds(chunks[chunk_index])) {
+      tokens.insert(tokens.end(), t.tokens.begin(), t.tokens.end());
+    }
+    if (tokens.empty()) {
+      return true;  // num_frames == 0: nothing to synthesize for this chunk
+    }
+
+    auto memory_info =
+        Ort::MemoryInfo::CreateCpu(OrtDeviceAllocator, OrtMemTypeDefault);
+    std::array<int64_t, 2> tokens_shape = {1,
+                                           static_cast<int64_t>(tokens.size())};
+    std::array<int64_t, 2> prompt_tokens_shape = {
+        1, static_cast<int64_t>(prompt_tokens.size())};
+    int32_t feat_dim = model_->GetMetaData().num_mels;
+    int32_t prompt_len = prompt_features.size() / feat_dim;
+    std::array<int64_t, 3> prompt_shape = {1, prompt_len, feat_dim};
+
+    Ort::Value text_condition = model_->Encode(
+        Ort::Value::CreateTensor(memory_info, tokens.data(), tokens.size(),
+                                 tokens_shape.data(), tokens_shape.size()),
+        Ort::Value::CreateTensor(memory_info, prompt_tokens.data(),
+                                 prompt_tokens.size(),
+                                 prompt_tokens_shape.data(),
+                                 prompt_tokens_shape.size()),
+        Ort::Value::CreateTensor(memory_info, prompt_features.data(),
+                                 prompt_features.size(), prompt_shape.data(),
+                                 prompt_shape.size()),
+        config.speed);
+
+    int32_t num_frames =
+        text_condition.GetTensorTypeAndShapeInfo().GetShape()[1];
+    if (num_frames <= prompt_len) {
+      SHERPA_ONNX_LOGE("num_frames (%d) <= prompt_len (%d)", num_frames,
+                       prompt_len);
+      return false;
+    }
+
+    int64_t n = static_cast<int64_t>(num_frames) * feat_dim;
+    const float *tc = text_condition.GetTensorData<float>();
+    out->text_condition.assign(tc, tc + n);
+    out->x.resize(n);
+    model_->FillNoise(out->x.data(), n);  // same draw order as Generate()
+    out->speech_condition.assign(n, 0.0f);
+    std::copy(prompt_features.begin(), prompt_features.end(),
+              out->speech_condition.begin());
+    out->num_frames = num_frames;
+    out->prompt_len = prompt_len;
+    out->feat_dim = feat_dim;
+    return true;
+  }
+
+  // [on-device-web-tts] x: final flow-matching state (num_frames, feat_dim).
+  // Drops the prompt frames, undoes feat_scale and runs the vocoder.
+  std::vector<float> ZipvoiceVocode(const float *x, int32_t num_frames,
+                                    int32_t prompt_len,
+                                    const GenerationConfig &config) const override {
+    float feat_scale =
+        config.GetExtraFloat("feat_scale", config_.model.zipvoice.feat_scale);
+    int32_t C = model_->GetMetaData().num_mels;
+    int32_t T = num_frames - prompt_len;
+    if (T <= 0) return {};
+    std::vector<float> mel = Transpose(x + prompt_len * C, T, C);  // (C, T)
+    Scale(mel.data(), 1 / feat_scale, mel.size(), mel.data());
+    auto memory_info =
+        Ort::MemoryInfo::CreateCpu(OrtDeviceAllocator, OrtMemTypeDefault);
+    std::array<int64_t, 3> shape = {1, C, T};
+    return vocoder_->Run(Ort::Value::CreateTensor<float>(
+        memory_info, mel.data(), mel.size(), shape.data(), shape.size()));
+  }
+
+  void ZipvoiceSetSeed(int32_t seed) override { model_->SetSeed(seed); }
+
  private:
   void PostInit() { InitMelBanks(); }
 
