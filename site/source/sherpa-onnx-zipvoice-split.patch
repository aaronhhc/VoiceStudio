+/**
+ * [on-device-web-tts] ZipVoice split pipeline. Prepare() runs frontend +
+ * encoder for text chunk `chunk_index` and draws the initial noise; the caller
+ * runs the flow-matching decoder loop (e.g. on WebGPU) and passes the final
+ * state to Vocode(). Concatenate chunk audio, then call ScaleSilence() with
+ * the silence_scale Generate() would use (C API default 0.2).
+ */
+typedef struct SherpaOnnxZipvoicePrepared {
+  const float *text_condition;    // (num_frames, feat_dim)
+  const float *speech_condition;  // (num_frames, feat_dim)
+  const float *x;                 // initial noise (num_frames, feat_dim)
+  int32_t num_frames;             // 0 => chunk has no tokens, skip it
+  int32_t prompt_len;
+  int32_t feat_dim;
+  int32_t num_chunks;
+  float t_shift;
+  float guidance_scale;
+  void *impl;  // private
+} SherpaOnnxZipvoicePrepared;
+
