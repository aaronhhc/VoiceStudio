+
+const SherpaOnnxGeneratedAudio *SherpaOnnxOfflineTtsScaleSilence(
+    const SherpaOnnxOfflineTts *tts, const float *samples, int32_t n,
+    float silence_scale) {
+  if (!tts || !samples || n <= 0) {
+    return nullptr;
+  }
+  sherpa_onnx::GeneratedAudio audio;
+  audio.samples.assign(samples, samples + n);
+  audio.sample_rate = tts->impl->SampleRate();
