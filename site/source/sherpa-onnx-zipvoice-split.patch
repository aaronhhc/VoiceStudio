+const SherpaOnnxZipvoicePrepared *SherpaOnnxOfflineTtsZipvoicePrepare(
+    const SherpaOnnxOfflineTts *tts, const char *text,
+    const SherpaOnnxGenerationConfig *config, int32_t chunk_index) {
+  if (!tts || !text || !config) {
+    SHERPA_ONNX_LOGE("tts, text and config must be non-null");
+    return nullptr;
+  }
+  sherpa_onnx::GenerationConfig cfg;
+  if (!ToGenerationConfig(config, &cfg)) {
+    return nullptr;
+  }
+  auto prepared = std::make_unique<sherpa_onnx::ZipvoicePrepared>();
+  if (!tts->impl->ZipvoicePrepare(text, cfg, chunk_index, prepared.get())) {
+    return nullptr;
+  }
+  auto *ans = new SherpaOnnxZipvoicePrepared;
+  ans->num_frames = prepared->num_frames;
+  ans->prompt_len = prepared->prompt_len;
+  ans->feat_dim = prepared->feat_dim;
+  ans->num_chunks = prepared->num_chunks;
+  ans->t_shift = prepared->t_shift;
+  ans->guidance_scale = prepared->guidance_scale;
+  ans->text_condition = prepared->text_condition.data();
+  ans->speech_condition = prepared->speech_condition.data();
+  ans->x = prepared->x.data();
+  ans->impl = prepared.release();  // owns the three buffers
+  return ans;
